#!/usr/bin/env bash
# aios-note-append — race-safe append of a block into a shared markdown note (the daily
# note), for concurrent /close-session writers. It serializes via a per-FILE mkdir mutex
# and MERGE-APPENDS: under the lock it re-reads the LATEST note, then inserts. So when
# /close-all fires N sessions at once, each lands its block in turn (A, then B reads the
# note *with* A and appends after it, then C) — ordered, zero clobber, all visible now.
# Inserts BEFORE the first line that STARTS WITH --before (e.g. "## Close of Day"); if no
# line starts with it, appends at the end. The anchoring is deliberate: a note is prose,
# and a sentence that merely quotes a heading must not become an insertion point.
# Then commits the note via aios-commit (scoped — never touches other files).
#
# Usage:
#   aios-note-append --note <path> --block-file <path> [--before "<marker>"] [-m "<msg>"] [--no-push]
#                    [--create-if-missing [--header "<first line>"]]
#   (block content comes from a FILE to avoid arg-size / newline issues)
#
# --create-if-missing: a note that does not exist yet (the first close of the day, before
#   anyone wrote the daily note) is created UNDER THE SAME LOCK as the append, then appended
#   to normally. Without it a missing note is an error, as before. The alternative -- each
#   caller creating the note with its own write first -- is a check-then-create race: two
#   sessions both see "missing", both write, and the slower one erases the faster one's block.
#   Under the lock only the first holder creates; every later holder finds the file and
#   appends. The parent directory is created too (a new month's calendar folder). The note
#   starts empty, or with --header's single line; creation is O_EXCL (noclobber), so a file
#   that appeared from a writer outside this helper is never overwritten.
set -uo pipefail
die(){ echo "aios-note-append: $*" >&2; exit 1; }

NOTE=""; BEFORE=""; MSG=""; BLOCKFILE=""; NOPUSH=(); CREATE=0; HEADER=""
while [ $# -gt 0 ]; do case "$1" in
  --note)       NOTE="$2"; shift 2 ;;
  --before)     BEFORE="$2"; shift 2 ;;
  --block-file) BLOCKFILE="$2"; shift 2 ;;
  -m)           MSG="$2"; shift 2 ;;
  --no-push)    NOPUSH=(--no-push); shift ;;
  --create-if-missing) CREATE=1; shift ;;
  --header)     HEADER="$2"; shift 2 ;;
  *) die "unknown arg: $1" ;;
esac; done
[ -n "$NOTE" ] || die "need --note <path>"
[ -n "$HEADER" ] && [ "$CREATE" = 0 ] && die "--header only applies with --create-if-missing"
if [ "$CREATE" = 1 ]; then
  # Refuse a directory or other non-file at the path: "create if missing" must not mean
  # "append into whatever is there".
  [ -e "$NOTE" ] && [ ! -f "$NOTE" ] && die "note path exists but is not a regular file: $NOTE"
else
  [ -f "$NOTE" ] || die "note does not exist: $NOTE (pass --create-if-missing to create it)"
fi
[ -n "$BLOCKFILE" ] && [ -f "$BLOCKFILE" ] || die "need --block-file <existing file>"
# -s, not just -f. An EMPTY block file is never a useful append: it produces a commit that
# captured nothing and reports success, so a caller whose block-generation step silently
# produced no output (a heredoc that failed, a template that rendered empty) is told its
# capture landed. Refuse the no-op rather than record it.
[ -s "$BLOCKFILE" ] || die "block file is empty: $BLOCKFILE — nothing to append"
[ -n "$MSG" ] || MSG="session: append capture block"

SELF="$(cd "$(dirname "$0")" && pwd)"
AC="$SELF/aios-commit"
[ -x "$AC" ] || die "aios-commit not found next to this script"

# --create-if-missing: the lock lives in the note's directory, so that directory must exist
# before acquire(). Created only now, after every argument check, so a refused run leaves
# nothing behind. mkdir -p is idempotent and safe to race.
if [ "$CREATE" = 1 ]; then
  mkdir -p "$(dirname "$NOTE")" 2>/dev/null || die "could not create the note's directory: $(dirname "$NOTE")"
fi

# ── per-file mutex (mkdir; dead-holder reclaim) ──
LOCK="${NOTE}.aios-lock"
LOCKDIR="$(dirname "$NOTE")"
# Reclaim a lock whose holder is dead -- but only THAT lock. Two waiters can read the same dead
# pid; with a bare `rm -rf` the slower one deleted the lock the faster one had just re-created,
# and both proceeded as holders. So removal is serialised by a second mkdir mutex, and under it
# the pid is re-read: the lock goes only if it still names the same pid and that pid is still
# dead. A fresh lock (a new pid, or none written yet) is never touched. The mutex is NEVER
# removed by anyone but the process that made it: clearing an "old" one would reopen the same
# race one level up (two observers, one deletes a fresh mutex). A reclaimer that dies inside
# this two-line section leaves it behind, and the lock wait then times out naming it.
reclaim(){ # $1 lock dir · $2 the dead pid that was read
  local m="$1.reclaim" cur
  if ! { mkdir "$m" 2>/dev/null && ( set -C; echo "$$" > "$m/pid" ) 2>/dev/null; }; then
    sleep 0.05; return 0
  fi
  cur=$(cat "$1/pid" 2>/dev/null || true)
  if [ -n "$cur" ] && [ "$cur" = "$2" ] && ! kill -0 "$cur" 2>/dev/null; then
    rm -rf "$1" 2>/dev/null
  fi
  rm -rf "$m" 2>/dev/null
  return 0
}
# Owning the lock takes TWO steps, and the second is the one that counts. `mkdir` alone is not a
# mutex everywhere: uutils mkdir 0.10.0 -- /usr/bin/mkdir on Ubuntu 26.04 -- checks, then
# creates, and reports success to several racers at once (measured on the runner: 6 of 40
# rounds of 50 racers had more than one winner, up to 10). So the pid file is created with
# `set -C` (noclobber): bash itself opens it O_EXCL, whatever mkdir the system ships, and
# exactly one racer can create it. Only that racer holds the lock; the rest see contention.
acquire(){ local t=0 h; while ! { mkdir "$LOCK" 2>/dev/null && ( set -C; echo "$$" > "$LOCK/pid" ) 2>/dev/null; }; do
    # mkdir can fail for two very different reasons, and only one of them is contention.
    # If the lock directory does not exist afterwards, mkdir failed because the location
    # is not writable — a read-only mount, a restrictive ACL, a cloud-sync folder mid-lock.
    # Waiting cannot fix that, so spinning the full timeout and then reporting a "lock
    # timeout" tells the operator to look for a peer session that was never there.
    # Do NOT infer "unwritable" from the lock being absent: a peer can release it in the
    # window between our mkdir failing and this test, and dying there would turn ordinary
    # contention -- the case this helper exists for -- into a spurious failure. Ask the
    # directory directly instead; that answer does not move underneath us.
    if [ ! -d "$LOCK" ] && [ ! -w "$LOCKDIR" ]; then
      die "cannot create the lock at $LOCK — $LOCKDIR is not writable (nothing was changed)"
    fi
    h=$(cat "$LOCK/pid" 2>/dev/null || true)
    if [ -n "$h" ] && ! kill -0 "$h" 2>/dev/null; then reclaim "$LOCK" "$h"; fi   # counts toward the timeout
    t=$((t+1)); if [ "$t" -gt 600 ]; then
      [ -d "$LOCK.reclaim" ] && die "note lock timeout: $LOCK.reclaim was left by a process that died while reclaiming. If no close is running, remove it: rm -rf \"$LOCK.reclaim\" — until then every run stops here"
      die "note lock timeout on $NOTE"; fi; sleep 0.1
  done; }
LOCKED=0
release(){ [ "$LOCKED" = 1 ] && { rm -rf "$LOCK" 2>/dev/null; LOCKED=0; }; }
trap release EXIT
acquire; LOCKED=1

# ── create-if-missing: decided UNDER the lock, so only the first holder creates ──
# `set -C` (noclobber) opens with O_EXCL: if a writer outside this helper created the note
# between our check and here, the redirect fails and we simply append to what it wrote.
CREATED=0
if [ "$CREATE" = 1 ] && [ ! -e "$NOTE" ]; then
  if ( set -C; if [ -n "$HEADER" ]; then printf '%s\n' "$HEADER"; else :; fi > "$NOTE" ) 2>/dev/null; then
    CREATED=1
  elif [ ! -f "$NOTE" ]; then
    die "could not create $NOTE (disk full, or the directory is not writable)"
  fi
fi

# ── merge-append: re-read the LATEST note under the lock, then insert ──
#
# The marker must match a line that STARTS with it -- `index($0,marker)==1`, not
# a bare `index($0,marker)`. A daily note is prose, and prose quotes headings:
# the moment someone writes a sentence mentioning "## Close of Day" (explaining
# the protocol, or documenting a bug in this very helper), an unanchored match
# turns that sentence into an insertion anchor. Measured 2026-09-11: a session
# block landed in the middle of an unrelated section, splitting it -- heading
# above the block, its bullets stranded below -- because a bullet written hours
# earlier happened to quote the marker. Nothing was lost, and nothing looked
# wrong to either session.
#
# ONE matcher decides both branches. The retired version asked `grep -qF` whether
# to enter the awk at all, so two different matchers had to agree about the same
# question; a marker that grep found and awk placed differently -- or found at all
# while awk's rule would not -- silently chose the wrong branch. The no-match case
# is now the awk's own END, so "where does it go" is answered exactly once.
if [ "$CREATED" = 1 ] && [ -z "$HEADER" ]; then
  # A note this run just created empty: the block IS the note -- no marker to find, and no
  # leading blank line (both other branches would prepend one).
  cat "$BLOCKFILE" >> "$NOTE" || die "could not append to $NOTE (disk full, or not writable) — the note may be partially written"
elif [ -n "$BEFORE" ]; then
  awk -v marker="$BEFORE" -v bf="$BLOCKFILE" '
    BEGIN{ blk=""; while((getline l < bf) > 0) blk = blk l "\n" }
    !done && index($0, marker) == 1 { printf "%s%s\n", blk, $0; done=1; next }
    { print }
    END{ if (!done) printf "\n%s", blk }      # marker absent -> append at the end
  ' "$NOTE" > "$NOTE.aiostmp" || { rm -f "$NOTE.aiostmp" 2>/dev/null
        die "could not write $NOTE.aiostmp (disk full, or the directory is not writable) — note unchanged"; }
  mv "$NOTE.aiostmp" "$NOTE" || die "could not replace $NOTE — note unchanged; your block is in $NOTE.aiostmp"
else
  { printf '\n' >> "$NOTE" && cat "$BLOCKFILE" >> "$NOTE"; } \
    || die "could not append to $NOTE (disk full, or not writable) — the note may be partially written"
fi

# ── commit the note via aios-commit (its own repo-mutex; lock order note→repo, no deadlock) ──
# ${arr[@]+"${arr[@]}"} — bash 3.2 (the macOS system bash) treats "${arr[@]}" on an EMPTY
# array as an unbound variable under `set -u`, so a plain expansion aborts HERE: after the
# note was already written, before it was committed. The +alternate form is the portable
# empty-safe expansion (no-op on bash 4+).
"$AC" -m "$MSG" ${NOPUSH[@]+"${NOPUSH[@]}"} -- "$NOTE" || die "aios-commit failed"
release; trap - EXIT
exit 0
